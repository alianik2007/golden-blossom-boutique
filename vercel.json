{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{*.json,api/*.json,products.json,orders.json,website_settings.json,whatsapp_config.json}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?_route=$1" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin.js", "destination": "/admin/admin.js" }
  ]
}
