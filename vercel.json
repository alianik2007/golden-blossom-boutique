{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?_route=$1" },
    { "source": "/api", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin.js", "destination": "/admin/admin.js" }
  ]
}

